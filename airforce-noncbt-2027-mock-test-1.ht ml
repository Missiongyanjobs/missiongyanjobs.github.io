let quizHTML = '';
testData.questions.forEach((q) => {
  quizHTML += `<div class="question-box" id="qbox${q.id}">`;
  quizHTML += `<div class="q-no">Question ${q.id}</div>`;
  quizHTML += `<div class="q-text">${q.question_hindi}<br><span style="color:#666; font-size:14px">${q.question_english}</span></div>`;
  quizHTML += `<div class="options">`;
  for(let key in q.options){
    quizHTML += `<label><input type="radio" name="q${q.id}" value="${key}"> <b>${key}.</b> ${q.options[key]}</label>`;
  }
  quizHTML += `</div></div>`;
});
document.getElementById('quiz-form').innerHTML = quizHTML;

// TIMER 20 MIN
let time = 20 * 60; let timerInterval;
function startTimer(){
  timerInterval = setInterval(()=>{
    let m = Math.floor(time/60), s = time%60;
    document.getElementById('timer').innerText = `⏰ Time Left: ${m}:${s<10?'0':''}${s}`;
    if(time <= 0){ clearInterval(timerInterval); submitTest(); }
    time--;
  },1000);
}

function submitTest(){
  clearInterval(timerInterval);
  let score = 0;
  testData.questions.forEach((q) => {
    let selected = document.querySelector(`input[name="q${q.id}"]:checked`);
    let qbox = document.getElementById(`qbox${q.id}`);
    if(selected){
      if(selected.value === q.answer){ score++; qbox.classList.add('correct'); }
      else{ qbox.classList.add('wrong'); }
    }else{ qbox.classList.add('wrong'); }
    qbox.innerHTML += `<div class="answer">✅ Correct Answer: ${q.answer}. ${q.options[q.answer]}</div>`;
  });
  document.getElementById('result').innerText = `🏆 Final Score: ${score} / ${testData.questions.length}`;
  document.querySelector('.btn').style.display = 'none';
}
